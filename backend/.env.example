# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Server Configuration
PORT=5500
JWT_SECRET=your_jwt_secret_key_here

# Brevo SMTP Configuration (free 300 emails/day)
# Get SMTP key from: https://app.brevo.com → Settings → SMTP & API
BREVO_SMTP_USER=your_brevo_login_email@gmail.com
BREVO_SMTP_PASS=your_brevo_smtp_key
CONTACT_EMAIL=your_contact_email@gmail.com

# Daily.co Live Class Integration
DAILY_API_KEY=your_daily_api_key_here

# AI Integration
GROQ_API_KEY=your_groq_api_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

NODE_TLS_REJECT_UNAUTHORIZED=0
